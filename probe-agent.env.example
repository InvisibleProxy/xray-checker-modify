# This file drives docker-compose.agent.yml, which builds the agent from a
# checkout. Deploying a probe normally does not need either of them: paste the
# Compose the admin UI returns from Create agent and run docker compose up -d,
# and the published ghcr.io image is pulled instead.
PROBE_AGENT_IMAGE=xray-checker-probe-agent:local
PROBE_AGENT_VERSION=local

# Copy these four values from Admin -> Settings -> Agents after creating the agent.
PROBE_AGENT_ID=agent_replace_me
PROBE_ENROLLMENT_TOKEN=enroll_replace_me
PROBE_CONTROLLER_URL=https://checker.example.com
PROBE_CONTROLLER_IP=198.51.100.10

# Container paths are normally left unchanged. The named volume and tmpfs mounts
# in docker-compose.agent.yml must continue to match them.
PROBE_IDENTITY_DIR=/var/lib/xray-checker-agent
PROBE_RUNTIME_DIR=/run/xray-checker-agent

# Optional PEM CA bundle for a private controller CA. For a public CA leave empty.
PROBE_CONTROLLER_CA_FILE=

# Agent-owned endpoint profiles. Keep these aligned with controller check
# semantics; job payloads contain only fixed profile IDs, never arbitrary URLs.
PROBE_IP_CHECK_URL=https://api.ipify.org?format=text
PROBE_STATUS_CHECK_URL=http://cp.cloudflare.com/generate_204
PROBE_DOWNLOAD_URL=https://proof.ovh.net/files/100Mb.dat
PROBE_DIRECT_CHECK_URL=https://api.ipify.org?format=text
PROBE_JOB_POLL_INTERVAL_SECONDS=5

# Shapes of the selectable diagnostics. The controller names a profile; how long
# and how often it runs stays agent-owned so a job cannot become a load test.
PROBE_LATENCY_SAMPLES=5
PROBE_STABILITY_SECONDS=20
PROBE_DNS_RESOLVER=1.1.1.1:53
PROBE_PROXY_TIMEOUT_SECONDS=30
PROBE_DOWNLOAD_TIMEOUT_SECONDS=60
PROBE_DOWNLOAD_MIN_SIZE=10000000

PROBE_AGENT_UID_GID=10001:10001
PROBE_AGENT_CPU_LIMIT=1.0
PROBE_AGENT_MEMORY_LIMIT=512m
PROBE_AGENT_PIDS_LIMIT=128
PROBE_AGENT_TMPFS_LIMIT=128m
PROBE_AGENT_RUNTIME_LIMIT=64m

# After the agent becomes Connected in the admin UI, this one-time value may
# be cleared. Keep the probe_agent_identity volume for future restarts.
