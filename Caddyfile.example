{
	email {$ACME_EMAIL}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	route {
		# Bedolaga sends Basic Auth; the controller validates it.
		# Keep METRICS_PROTECTED=true in the controller environment.
		@bedolaga {
			path /metrics
			method GET
			remote_ip {$BEDOLAGA_PUBLIC_IP}
		}
		reverse_proxy @bedolaga xray-checker:2112

		@probe_agent {
			path /api/v1/agent/enroll /api/v1/agent/heartbeat /api/v1/agent/jobs/next /api/v1/agent/observations
			method POST
		}
		reverse_proxy @probe_agent xray-checker:2112 {
			header_up X-Xray-Checker-Proxy-Secret {$PROBE_TRUSTED_PROXY_SECRET}
			header_up X-Xray-Checker-Client-IP {remote_host}
		}
		# Dashboard, admin, public API and all other paths stay private.
		respond 404
	}
}
