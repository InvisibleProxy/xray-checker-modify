{
	email {$ACME_EMAIL}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	route {
		@sensitive path /admin* /metrics /health /api/v1/admin* /api/v1/proxies* /api/v1/config /api/v1/status /api/v1/system* /api/v1/docs /api/v1/openapi.yaml
		respond @sensitive 404

		@probe_agent {
			path /api/v1/agent/enroll /api/v1/agent/heartbeat /api/v1/agent/jobs/next /api/v1/agent/observations
			method POST
		}
		reverse_proxy @probe_agent xray-checker:2112 {
			header_up X-Xray-Checker-Proxy-Secret {$PROBE_TRUSTED_PROXY_SECRET}
			header_up X-Xray-Checker-Client-IP {remote_host}
		}
		@probe_agent_denied path /api/v1/agent/*
		respond @probe_agent_denied 404

		@public path / /static/* /config/* /api/v1/public/proxies
		reverse_proxy @public xray-checker:2112

		respond 404
	}
}
