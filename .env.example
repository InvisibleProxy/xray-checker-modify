# Published by .github/workflows/controller-image.yml. Production deployments
# should replace :main with the immutable @sha256 digest from the workflow summary.
CONTROLLER_IMAGE=ghcr.io/invisibleproxy/xray-checker-controller:main

PUBLIC_DOMAIN=status.example.com
ACME_EMAIL=admin@your-real-domain.com
# Replace with the public egress IP of the Bedolaga server (IPv4 or IPv6).
# Only this source may request GET /metrics through Caddy.
BEDOLAGA_PUBLIC_IP=203.0.113.10

# Multiple subscription sources can be provided as one quoted, comma-separated value.
SUBSCRIPTION_URL="https://provider.example/sub#Public%20VPN%20Status"
# SUBSCRIPTION_URL="https://provider-one.example/sub,https://provider-two.example/sub"

# Caddy exposes only Bedolaga metrics and the four agent POST endpoints.
# Dashboard/admin remain on host loopback: http://127.0.0.1:2112/admin
WEB_PUBLIC=false
WEB_SHOW_DETAILS=false
# Required: Caddy restricts the metrics source IP; the controller checks Basic Auth.
# Use these credentials in Bedolaga SERVER_STATUS_METRICS_USERNAME/PASSWORD.
METRICS_PROTECTED=true
METRICS_USERNAME=admin
METRICS_PASSWORD=replace-with-a-long-random-password

PROXY_CHECK_METHOD=status
PROXY_RECOVERY_INTERVAL=15
LOG_LEVEL=info
SPEED_TEST_URL=https://proof.ovh.net/files/10Mb.dat

# Sensitive Telegram settings are configured through env variables only.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_ADMIN_IDS=

# Optional Remnawave subscription announce integration. The API token needs:
# hosts:list, internal-squads:list, external-squads:list, external-squads:update.
REMNAWAVE_ANNOUNCE_ENABLED=false
REMNAWAVE_API_URL=https://panel.example.com
REMNAWAVE_API_TOKEN=
REMNAWAVE_API_TIMEOUT_SECONDS=10
REMNAWAVE_RECONCILE_INTERVAL_SECONDS=60
REMNAWAVE_TOPOLOGY_INTERVAL_SECONDS=300

# Outbound-only remote diagnostic agents. Generate a long random proxy secret;
# Caddy uses it to bind the public source IP it observed to the controller request.
REMOTE_DIAGNOSTICS_ENABLED=false
REMOTE_DIAGNOSTICS_AUTOMATION_ENABLED=false
PROBE_AUTOMATION_COOLDOWN_MINUTES=30
PROBE_AUTOMATION_ALERT_WAIT_SECONDS=90
PROBE_AUTOMATION_MAX_CONCURRENT=2
# Periodic per-agent reachability sweep. It only records what each agent saw next
# to what the checker saw; it never writes availability, incidents or Remnawave.
REACHABILITY_SWEEP_ENABLED=false
REACHABILITY_SWEEP_INTERVAL_MINUTES=60
REACHABILITY_SWEEP_TIMEOUT_SECONDS=120
# Empty selects the status probe, which every agent supports.
REACHABILITY_SWEEP_PROFILE=
# The controller address every agent enrolls against. Setting it here prefills
# the create-agent form, so it is stated once instead of per agent. Both or
# neither: half a default still has to be typed every time.
PROBE_CONTROLLER_URL=
PROBE_CONTROLLER_IP=
PROBE_TRUSTED_PROXY_SECRET=replace-with-a-long-random-proxy-secret
# Published by .github/workflows/probe-agent-image.yml. Pin an immutable digest
# (image@sha256:...) once agents are deployed: the agent and the controller must
# stay on the same protocol version.
PROBE_AGENT_IMAGE=ghcr.io/invisibleproxy/xray-checker-probe-agent:main
PROBE_ENROLLMENT_TTL_MINUTES=15
PROBE_HEARTBEAT_INTERVAL_SECONDS=30
PROBE_HEARTBEAT_MAX_SKEW_SECONDS=120
